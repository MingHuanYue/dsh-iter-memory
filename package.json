{
  "name": "dsh-iter-memory",
  "version": "1.0.1",
  "description": "迭代记忆：把我的状态和开口合成一条线——潮位会自己退回基线，不定时的主动开口读它、也改它，配一张 24 小时曲线和设置页",
  "license": "MIT",
  "author": "MingHuanYue",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MingHuanYue/dsh-iter-memory.git"
  },
  "homepage": "https://github.com/MingHuanYue/dsh-iter-memory#readme",
  "bugs": {
    "url": "https://github.com/MingHuanYue/dsh-iter-memory/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "proactive",
    "companion",
    "ai-companion",
    "mood",
    "state",
    "memory"
  ],
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test tests/core.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots"
      ],
      "external": [
        "react"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "engines": {
    "dsh": ">=0.1.7-rc.1",
    "node": ">=22"
  }
}
